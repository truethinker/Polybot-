# Opción A: trackear un market concreto por slug (se cerrará rápido)
MARKET_SLUG=btc-updown-5m-1771407900

# Opción B: si el slug está cerrado, el bot intenta saltar al siguiente market activo de la serie
# (puede auto-derivarlo del payload, pero mejor fijarlo tú)
SERIES_SLUG=btc-up-or-down-5m

# Endpoints (defaults OK)
GAMMA_BASE=https://gamma-api.polymarket.com
WS_BASE=wss://ws-subscriptions-clob.polymarket.com

# Logging / CSV
WRITE_CSV=0
CSV_PATH=quotes.csv
POLL_SECONDS=3

# Auth opcional (si tu setup lo requiere)
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=
